packages: .

-- heosd.cabal требует base ^>=4.21.0.0, т.е. GHC 9.12.
-- Глобальный ghcup-компилятор по умолчанию — 9.10.3 (base 4.20),
-- поэтому обычный `cabal build` падал на резолве зависимостей.
-- Пиним компилятор на уровне проекта, чтобы не трогать остальные проекты.
with-compiler: ghc-9.12.2
