cabal-version:      3.14
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'heosd' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               heosd

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.0.1

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            MIT

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             Cybervoid

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         cybervoid@shenshin.nl

-- A copyright notice.
-- copyright:
category:           Control
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options:  -Wall
                  -Wcompat
                  -Wincomplete-record-updates
                  -Wincomplete-uni-patterns
                  -Wpartial-fields
                  -Wredundant-constraints
                  -Wmissing-home-modules

common defaults
    import:             warnings
    default-language:   GHC2024
    default-extensions: TypeFamilies
                        DerivingStrategies
                        -- using brackets for Text and ByteString's
                        OverloadedStrings
                        -- \case ->
                        LambdaCase
                        -- record.field
                        OverloadedRecordDot
                        -- allows using same field names in different records
                        DuplicateRecordFields
                        -- turns off laziness on records
                        StrictData
                        -- allows holes in signatures: func :: Int -> _ 
                        PartialTypeSignatures
                        -- (1; 3; 5) -> _
                        OrPatterns
    build-depends:      base ^>=4.21.0.0

library
    import:           defaults

    -- Modules exported by the library.
    exposed-modules:  Heos
                      Heos.Url
                      Heos.Url.Internal
                      Heos.Envelope
                      Heos.Envelope.Internal
                      Heos.Config
                      Heos.Discovery
                      Heos.Discovery.Internal
                      Heos.Connection
                      Heos.Connection.Internal
                      Heos.Connection.Reconnect
                      Heos.Connection.Parameters
                      Heos.Connection.Framing
                      Heos.Effect
                      Heos.Handler.Live
                      Heos.Handler.Fake
                      Heos.Handler.Fixtures
                      Heos.Service
                      Heos.Mcp
                      Heos.Http
                      Heos.Command
                      Heos.Command.Internal
                      Heos.ToParam
                      Heos.Time
                      Heos.Json
                      Heos.Types
                      Heos.Types.Records
                      Heos.Types.Enums
                      Heos.Types.Newtypes

    -- Modules included in this library but not exported.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:  text
                  , bytestring
                  , network
                  , stm
                  , aeson
                  , async
                  , yaml
                  , scotty
                  , mcp-server
                  , effectful
                  , retry
                  , containers
                  , exceptions
                  , deepseq
                  
        
    -- Directories containing source files.
    hs-source-dirs:   src

executable heosd
    import:           defaults
    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    -- Modules included in this executable, other than Main.
    other-modules: FirstTalk

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:    heosd
                    , stm
                    , async
                    , effectful
                    , deepseq
                    , text


    -- Directories containing source files.
    hs-source-dirs:   app

    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"

test-suite heosd-test
    import:           defaults
    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files.
    hs-source-dirs:   test

    -- The entrypoint to the test suite.
    main-is:          Main.hs

    other-modules:    Heos.UrlSpec
                      Heos.EnvelopeSpec
                      Heos.CommandSpec
                      Heos.DiscoverySpec
                      Heos.ConnectionSpec
                      Heos.ReconnectSpec
                      Heos.PayloadSpec
                      Heos.LiveSpec
                      Heos.FakeSpec
                      Heos.FakeDevice

    build-tool-depends: hspec-discover:hspec-discover

    -- Test dependencies.
    build-depends:    heosd
                    , text
                    , bytestring
                    , network
                    , stm
                    , async
                    , retry
                    , effectful
                    , hspec
                    , QuickCheck
                    , directory
                    , filepath
                    , aeson
                    , containers
